{
	"name": "express-server-app",
	"version": "0.5.3",
	"description": "A minimal opinionated set of tools to create Web and REST servers",
	"main": "index.js",
	"bin": {
		"express-server-app": "./bin/express-server-app.js"
	},
	"scripts": {
		"test": "jest --watchAll --coverage",
		"demo": "cd demo && node ../bin/express-server-app.js start",
		"demo:debug": "cd demo && node ../bin/express-server-app.js debug"
	},
	"jest": {
		"coveragePathIgnorePatterns": [
			"fixtures/"
		],
		"testPathIgnorePatterns": [
			"fixtures/"
		]
	},
	"author": "53JS",
	"license": "MIT",
	"devDependencies": {
		"eslint": "^8.57.0",
		"eslint-config-53js": "^1.2.0",
		"eslint-config-airbnb": "^19.0.4",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-jest": "^28.8.0"
	},
	"dependencies": {
		"@hapi/boom": "^10.0.1",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"dotenv-expand": "^12.0.1",
		"express": "^4.21.2",
		"express-json-validator-middleware": "^3.0.1",
		"helmet": "^8.0.0",
		"jest": "^29.7.0",
		"nodemon": "^3.1.7",
		"pino": "^9.5.0",
		"pino-http": "^10.3.0",
		"pino-pretty": "^13.0.0"
	},
	"keywords": [
		"API",
		"boom",
